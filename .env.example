NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated exact browser origins. Never use '*' with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=devlens
POSTGRES_USER=devlens
POSTGRES_PASSWORD=devlens

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Local example only; production requires managed persistent PostgreSQL.
DATABASE_URL=postgresql+asyncpg://devlens:devlens@localhost:5432/devlens
ANALYSIS_CACHE_TTL_SECONDS=900

# Backend-only GitHub App authentication settings. Leave empty until the app is registered.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
AUTH_STATE_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:3000
